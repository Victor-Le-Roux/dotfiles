      "tooltip": true,
      "on-click": "~/.config/waybar/scripts/aoc_rotate.sh toggle"
    },
    "custom/power": {
      "format": "⏻",
      "tooltip": false,
      "on-click": "/home/victor/.local/bin/wlogout"
    },
    "exclusive": true,
    "group/estampe": {
      "orientation": "vertical",
      "modules": [
        "group/estampe-main",
        "group/estampe-extra"
      ]
    },
    "output": "HDMI-A-1",
    "name": "estampe-secondary",
    "group/estampe-main": {
      "orientation": "horizontal",
      "modules": [
        "ext/workspaces",
        "custom/bluetooth",
        "pulseaudio",
        "group/system",
        "clock",
        "custom/aoc-rotate",
        "custom/power"
      ]
    },
    "group/estampe-extra": {
      "orientation": "horizontal",
      "modules": [
        "tray",
        "custom/calendar",
        "custom/updates"
      ]
    }
  }
]
