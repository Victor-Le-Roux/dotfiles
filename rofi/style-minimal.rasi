configuration {
    modi: "drun,window";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
    disable-history: false;
    sort: true;
    sorting-method: "fzf";
    matching: "fuzzy";
    click-to-exit: true;
}

* {
    font: "JetBrains Mono 13";
    background: #eee7d5;
    background-alt: #d8d0b9;
    foreground: #3c3b31;
    selected: #d8d0b9;
    urgent: #a5543c;
}
window {
    location: center;
    anchor: center;
    x-offset: 0px;
    y-offset: -72px;
    width: 520px;
    border: 1px;
    border-radius: 0px;
    border-color: #9e9175;
    background-color: @background;
    }
mainbox {
    spacing: 0px;
    padding: 0px;
    background-color: transparent;
    children: [ "textbox-heading", "inputbar", "listview" ];
    }
textbox-heading {
    expand: false;
    str: "Applications";
    padding: 14px 22px;
    font: "JetBrains Mono 11";
    text-color: #726b58;
    background-color: transparent;
    border: 0px 0px 1px;
    border-color: #b4a78a;
    }
inputbar {
    spacing: 10px;
    margin: 12px 20px;
    padding: 12px 8px;
    border: 0px 0px 1px;
    border-color: #726b58;
    background-color: transparent;
    children: [ "entry" ];
    }
entry {
    expand: true;
    text-color: @foreground;
    placeholder: "Search applications";
    placeholder-color: #726b58;
    background-color: transparent;
    }
listview {
    lines: 8;
    columns: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
    margin: 0px 20px 20px;
    background-color: transparent;
    }
element {
    children: [ "element-icon", "element-text" ];
    spacing: 14px;
    padding: 12px 10px;
    border: 0px 0px 0px 3px;
    border-color: transparent;
    background-color: transparent;
    text-color: @foreground;
    }
element normal.normal, element normal.active {
    background-color: transparent;
    text-color: @foreground;
    }
element selected.normal, element selected.active {
    background-color: @selected;
    text-color: @foreground;
    border-color: #a5543c;
    }
element normal.urgent, element selected.urgent {
    background-color: @urgent;
    text-color: #fff4dd;
    }
element-icon {
    enabled: true;
    size: 24px;
    background-color: transparent;
    text-color: inherit;
    }
element-text {
    background-color: transparent;
    text-color: inherit;
    }
